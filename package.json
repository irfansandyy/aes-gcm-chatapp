{
  "name": "cipherroom",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Accountless encrypted rooms and peer-to-peer communication with manual AES-GCM and a five-step KDC.",
  "scripts": {
    "postinstall": "node scripts/vendor.mjs",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "configure": "node scripts/configure.mjs",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "express": "5.3.0",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "jsdom": "30.1.3"
  }
}
