# Generate real values with: node scripts/configure.mjs --ip 192.168.1.10
APP_PORT=3000
PORT=3000
HOST=0.0.0.0
PUBLIC_IP=192.168.1.10
KDC_KEYS_FILE=.secrets/kdc-keys.json
KDC_STRICT_THREE_IPS=true
TURN_PUBLIC_IP=192.168.1.10
TURN_PORT=3478
TURN_SECRET_FILE=.secrets/turn-secret
# Optional additional STUN endpoints, separated by commas.
STUN_URLS=
# Enable only when access is restricted to your known reverse proxy.
TRUST_PROXY=false
MAX_CLIENTS=256
MAX_ROOMS=128
MAX_CLIENTS_PER_IP=12
# Per-connection encrypted frames per second, with a burst of the same size.
SOCKET_FRAME_RATE=2000
